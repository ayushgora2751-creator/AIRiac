# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Web frontend & Node configs
[*.{js,jsx,ts,tsx,json,css,scss,html,yaml,yml}]
indent_style = space
indent_size = 2

# Makefiles must use tabs
[Makefile]
indent_style = tab

# Markdown files (preserve trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
