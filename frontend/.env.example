# =================================================================
# AIRiac: Urban Air Quality Assistant (Frontend Environment Template)
# =================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# MapTiler Cloud API Key for vector and satellite tile rendering
# Obtain a free developer key at https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Default Geographic Settings (Chandigarh UT)
VITE_DEFAULT_CITY=Chandigarh
VITE_DEFAULT_LAT=30.7333
VITE_DEFAULT_LNG=76.7794
VITE_DEFAULT_ZOOM=12

# Application Branding
VITE_APP_TITLE=AIRiac - Urban Air Quality Assistant
