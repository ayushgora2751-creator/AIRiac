# =================================================================
# AIRiac: Urban Air Quality Assistant (Chandigarh-First)
# Root .gitignore
# =================================================================

# -----------------------------------------------------------------
# Root Untracked Pollution & Repositories
# -----------------------------------------------------------------
public-apis/
node_modules/
package-lock.json
package.json

# -----------------------------------------------------------------
# Environment & Local Secrets
# -----------------------------------------------------------------
.env
.env.local
.env.*.local
*.env

# -----------------------------------------------------------------
# Operating System & IDE Artifacts
# -----------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------
# Python & Backend Artifacts
# -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Pytest & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Django local media & db
*.sqlite3
*.db
backend/media/
backend/static_collected/

# -----------------------------------------------------------------
# Frontend & Node Artifacts
# -----------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------
# Docker & Scratch Directories
# -----------------------------------------------------------------
.docker/
docker-compose.override.yml
*.log
