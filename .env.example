# =================================================================
# AIRiac: Urban Air Quality Assistant (Chandigarh-First)
# Environment Variable Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Django Core Configuration
# -----------------------------------------------------------------
# Cryptographic signing key (generate a high-entropy 50+ character random string for production)
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend,0.0.0.0

# -----------------------------------------------------------------
# 2. PostgreSQL with PostGIS Configuration
# -----------------------------------------------------------------
POSTGRES_DB=airiac_db
POSTGRES_USER=airiac
POSTGRES_PASSWORD=your_secure_db_password_here
DB_NAME=airiac_db
DB_USER=airiac
DB_PASSWORD=your_secure_db_password_here
# Use 'db' for Docker Compose; use 'localhost' for local host development
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------
# 3. Redis & Caching Configuration
# -----------------------------------------------------------------
# Use 'redis' for Docker Compose; use 'localhost' for local host development
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
REDIS_PORT=6379

# -----------------------------------------------------------------
# 4. Celery Task Queue & Scheduler
# -----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------
# 5. Security & CORS Configuration
# -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# -----------------------------------------------------------------
# 6. SimpleJWT Authentication Settings
# -----------------------------------------------------------------
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------
# 7. Geographic & Regional Settings (Chandigarh UT)
# -----------------------------------------------------------------
TIME_ZONE=Asia/Kolkata
DEFAULT_CITY=Chandigarh
CHANDIGARH_BBOX_MIN_LAT=30.6500
CHANDIGARH_BBOX_MAX_LAT=30.8200
CHANDIGARH_BBOX_MIN_LNG=76.6800
CHANDIGARH_BBOX_MAX_LNG=76.8800

# -----------------------------------------------------------------
# 8. External API Integrations (Third-Party Services)
# -----------------------------------------------------------------
# OpenWeather Air Pollution & Meteorology API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenAQ v3 API Key for global ground monitor networks (https://openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# IPStack Geolocation API for IP-based client positioning (https://ipstack.com/)
IPSTACK_API_KEY=your_ipstack_api_key_here

# Google Gemini Generative AI API for personalized advice (https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mailercloud Transactional Email API for emergency alerts (https://mailercloud.com/)
MAILERCLOUD_API_KEY=your_mailercloud_api_key_here
MAILERCLOUD_SENDER_EMAIL=alerts@airiac.org

# Shipday On-Demand Delivery API for clean-air protective gear dispatch (https://shipday.com/)
SHIPDAY_API_KEY=your_shipday_api_key_here

# MapTiler Cloud API for interactive satellite/vector map tiles (https://cloud.maptiler.com/)
MAPTILER_API_KEY=your_maptiler_api_key_here

# -----------------------------------------------------------------
# 9. Mock Data & External Provider Settings (Zero Network Fallback)
# -----------------------------------------------------------------
USE_MOCK_DATA=True
AIR_QUALITY_DATA_PROVIDER=mock_cpcb
WEATHER_DATA_PROVIDER=mock_imd
FIRMS_DATA_PROVIDER=mock_firms

# -----------------------------------------------------------------
# 10. Frontend Configuration
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
VITE_APP_TITLE=AIRiac - Urban Air Quality Assistant
VITE_DEFAULT_CITY=Chandigarh
VITE_DEFAULT_LAT=30.7333
VITE_DEFAULT_LNG=76.7794
VITE_DEFAULT_ZOOM=12
FRONTEND_PORT=5173
WEB_PORT=8000
